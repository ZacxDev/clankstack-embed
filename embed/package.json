{
  "name": "@clank-stack/agent-embed",
  "version": "0.1.0",
  "description": "Embeddable web component + headless JS SDK for the clankstack agent framework — paste a snippet and get a streaming agent chat on any website.",
  "type": "module",
  "main": "./dist/agent.js",
  "module": "./dist/agent.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/agent.js"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "author": "Zach Lowden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZacxDev/clankstack-embed.git",
    "directory": "embed"
  },
  "homepage": "https://github.com/ZacxDev/clankstack-embed#readme",
  "bugs": {
    "url": "https://github.com/ZacxDev/clankstack-embed/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "clankstack",
    "agent",
    "chat",
    "web-component",
    "lit",
    "sse",
    "embed"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "^3.2.1",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  }
}
